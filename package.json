{
  "name": "opencode-command-hooks",
  "version": "0.7.1",
  "description": "OpenCode plugin for declaratively attaching shell commands to tool, subagent, and session events",
  "type": "module",
  "main": "dist/v2.js",
  "types": "dist/v2.d.ts",
  "exports": {
    ".": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "index.js",
    "types"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:all": "npm run build",
    "test": "bun test",
    "test:v2": "bun test tests/v2.plugin.test.ts tests/v2.package.test.ts",
    "test:v2:e2e": "OPENCODE2_E2E=1 bun test tests/e2e.v2.test.ts",
    "test:v2:e2e:live": "OPENCODE2_E2E=1 OPENCODE2_E2E_LIVE=1 bun test tests/e2e.v2.test.ts",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "ci:check": "npm run lint && npm run typecheck && npm test",
    "typecheck:bun": "bun --bun tsc --noEmit",
    "typecheck:bun-build": "bun build src/index.ts --target=bun",
    "typecheck:bun-run": "bun run src/index.ts",
    "test:v1:e2e": "npm run build && OPENCODE_E2E=1 bun test tests/e2e.v1-headless.test.ts",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "hooks",
    "shell",
    "commands",
    "lifecycle"
  ],
  "author": "Shane Bishop <71288697+shanebishop1@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanebishop1/opencode-command-hooks.git"
  },
  "bugs": {
    "url": "https://github.com/shanebishop1/opencode-command-hooks/issues"
  },
  "homepage": "https://github.com/shanebishop1/opencode-command-hooks#readme",
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.29",
    "@opencode-ai/sdk": "^1.18.29",
    "@opencode/plugin": "2.0.12",
    "js-yaml": "^4.3.2",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/picomatch": "^4.0.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "bun": ">=1.0.0",
    "opencode": ">=1.18.29"
  }
}
